{
  "name": "@govuk-one-login/mobile-wallet-mdoc-builder",
  "version": "0.2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/govuk-one-login/mobile-wallet-mdoc-builder.git"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "pre-commit install --hook-type pre-commit --hook-type commit-msg --hook-type pre-push",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "test": "vitest run --coverage",
    "test:component": "npm run build && vitest run --config vitest.config.component.ts",
    "test:component:ci": "vitest run --config vitest.config.component.ts",
    "publish-v0-to-npm": "./publish-v0-to-npm.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "cbor2": "2.3.0",
    "zod": "4.4.3"
  }
}
