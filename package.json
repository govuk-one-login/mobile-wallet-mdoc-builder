    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
