{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.16.0/schemas/schema.json",
  "services": [
    {
      "product": "Mobile Wallet",
      "component": "mobile-wallet-mdoc-builder",
      "promotionType": "library",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pull-request-checks.yaml",
            "path": "$.jobs.conventional-commits"
          },
          "checks": [
            {
              "name": "code style and linting"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pull-request-checks.yaml",
            "path": "$.jobs.build-and-component-tests"
          },
          "checks": [
            {
              "name": "integration"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pull-request-checks.yaml",
            "path": "$.jobs.run-code-quality-and-security-analysis"
          },
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "code quality"
            },
            {
              "name": "vulnerability detection"
            },
            {
              "name": "secret scanning"
            }
          ]
        }
      ]
    }
  ]
}
