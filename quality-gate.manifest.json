{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.13.0/schemas/schema.json",
  "services": [
    {
      "product": "Mobile Wallet",
      "component": "mobile-wallet-mdoc-builder",
      "promotionType": "library",
      "checks": [
        {
          "checkTypes": ["code style and linting"],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pull-request-checks.yaml",
            "path": "$.jobs.conventional-commits"
          }
        },
        {
          "checkTypes": ["integration"],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pull-request-checks.yaml",
            "path": "$.jobs.build-and-component-tests"
          }
        },
        {
          "checkTypes": [
            "unit",
            "unit test coverage",
            "code quality",
            "vulnerability detection",
            "secret scanning"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pull-request-checks.yaml",
            "path": "$.jobs.run-code-quality-and-security-analysis"
          }
        },
        {
          "checkTypes": ["code style and linting"],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pull-request-checks.yaml",
            "path": "$.jobs.typecheck-lint-format"
          }
        },
        {
          "checkTypes": ["code style and linting"],
          "phase": "pre-release",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/push-to-main.yaml",
            "path": "$.jobs.conventional-commits"
          }
        },
        {
          "checkTypes": ["integration"],
          "phase": "pre-release",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/push-to-main.yaml",
            "path": "$.jobs.build-and-component-tests"
          }
        },
        {
          "checkTypes": [
            "unit",
            "unit test coverage",
            "code quality",
            "vulnerability detection",
            "secret scanning"
          ],
          "phase": "pre-release",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/push-to-main.yaml",
            "path": "$.jobs.run-code-quality-and-security-analysis"
          }
        },
        {
          "checkTypes": ["code style and linting"],
          "phase": "pre-release",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/push-to-main.yaml",
            "path": "$.jobs.typecheck-lint-format"
          }
        }
      ]
    }
  ]
}
